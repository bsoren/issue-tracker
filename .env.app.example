# Copy to .env.app for Docker Compose. Match credentials in .env.mysql.
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
APP_PORT=3000
# Optional locally; required only with compose.traefik.yaml on the VPS.
APP_DOMAIN=issue-tracker.example.com
# Required only for the bridge-network overlay, compose.traefik.yaml.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
DATABASE_NETWORK=mysql_database

DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=issue_tracker
DATABASE_USER=issue_tracker
DATABASE_PASSWORD=change-me
# Only disable TLS for the bundled MySQL on the private Docker network.
DATABASE_SSL=false
# Used by local Prisma CLI commands, not the Compose migration service.
DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# Local URL. The Traefik overlay derives the HTTPS URL from APP_DOMAIN.
NEXTAUTH_URL="http://localhost:${APP_PORT}"
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
