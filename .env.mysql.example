# Copy to .env.mysql. Match the app's DATABASE_NAME/USER/PASSWORD values.
MYSQL_DATABASE=issue_tracker
MYSQL_USER=issue_tracker
MYSQL_PASSWORD=change-me
# MySQL generates the initial root password and writes it to its container log.
MYSQL_RANDOM_ROOT_PASSWORD=yes

# Shared network; use the same name in every connected app.
DATABASE_NETWORK=mysql_database
# Persistent storage for the shared MySQL server.
MYSQL_VOLUME_NAME=mysql_data
